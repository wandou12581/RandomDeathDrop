    "main": ["com.halfdrop.HalfDropFabric"]
  },
  "mixins": ["halfdrop.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
